@model IReadOnlyCollection<AppDiemDanh.Pages.Admin.ShiftGroupsModel.ShiftGroupRow>
<div class="table-wrap"><table class="data-table"><thead><tr><th>Mã nhóm</th><th>Tên nhóm</th><th>Số lượng nhân viên</th><th>Mô tả</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var group in Model)
{
    <tr><td><strong>@group.Code</strong></td><td>@group.Name</td><td>@group.EmployeeCount</td><td>@(string.IsNullOrWhiteSpace(group.Description) ? "—" : group.Description)</td><td><span class="badge badge-success">@(group.IsActive ? "Hoạt động" : "Tạm dừng")</span></td><td><div class="toolbar"><button class="btn btn-secondary" type="button" data-edit-shift-group data-id="@group.Id">Sửa</button><button class="btn btn-danger" type="button" data-delete-shift-group data-id="@group.Id" data-name="@group.Name">Xóa</button></div></td></tr>
}
@if (Model.Count == 0) { <tr><td colspan="6" class="muted" style="text-align:center;padding:32px">Chưa có nhóm phân ca.</td></tr> }
</tbody></table></div>

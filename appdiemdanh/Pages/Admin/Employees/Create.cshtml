@page
@model AppDiemDanh.Pages.Admin.Employees.CreateModel
@{ ViewData["Title"] = "Thêm nhân viên"; }
<div class="section-head"><div><p class="eyebrow">QUẢN LÝ NHÂN SỰ</p><h1>Thêm tài khoản nhân viên</h1><p class="muted">Tạo tài khoản ban đầu để nhân viên kích hoạt trên ứng dụng.</p></div><a class="btn btn-secondary" asp-page="/Admin/Employees">← Về danh sách nhân viên</a></div>
@if(Model.ErrorMessage != null){<div class="alert alert-danger">@Model.ErrorMessage</div>}
<div class="card"><form method="post" class="grid grid-2"><div><label>Mã nhân viên</label><input class="form-control" asp-for="Input.EmployeeCode" required maxlength="50" /></div><div><label>Họ và tên</label><input class="form-control" asp-for="Input.FullName" required maxlength="200" /></div><div><label>Email</label><input class="form-control" asp-for="Input.Email" type="email" maxlength="320" placeholder="nhanvien@example.com" /><small class="muted">Email sẽ cần xác minh bằng OTP.</small></div><div><label>Mật khẩu tạm</label><input class="form-control" asp-for="Input.TemporaryPassword" type="password" required minlength="6" maxlength="128" /></div><div><label>Vai trò</label><select class="form-control" asp-for="Input.Role" required><option>Employee</option><option>Manager</option><option>HR</option><option>Admin</option></select></div><div><label>Chi nhánh</label><select class="form-control" asp-for="Input.BranchId" required><option value="0">-- Chọn chi nhánh --</option>@foreach(var branch in Model.Branches){<option value="@branch.Id">@branch.Name</option>}</select></div><div><label>Phòng ban</label><select class="form-control" asp-for="Input.DepartmentId"><option value="">-- Chưa phân phòng ban --</option>@foreach(var department in Model.Departments){<option value="@department.Id">@department.Name</option>}</select></div><div class="toolbar" style="align-items:end"><button class="btn btn-primary" type="submit">Tạo tài khoản</button><a class="btn btn-secondary" asp-page="/Admin/Employees">Hủy</a></div></form></div>

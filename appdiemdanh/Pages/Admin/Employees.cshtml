@page
@model AppDiemDanh.Pages.Admin.EmployeesModel
@{ ViewData["Title"] = "Nhân viên"; }
<div class="section-head"><div><p class="eyebrow">QUẢN LÝ NHÂN SỰ</p><h1>Danh sách nhân viên</h1></div><a class="btn btn-primary" asp-page="/Admin/Employees/Create">+ Thêm nhân viên</a></div>
@if (!string.IsNullOrEmpty(Model.Message)){<div class="alert alert-success">@Model.Message</div>}
<div class="grid grid-3" style="margin-bottom:20px"><div class="card stat-card"><div class="stat-label">Tổng tài khoản</div><div class="stat-value">@Model.TotalAccounts</div></div><div class="card stat-card"><div class="stat-label">Đã kích hoạt</div><div class="stat-value">@Model.ActivatedAccounts</div><div class="stat-note">Đã đăng ký trên ứng dụng</div></div><div class="card stat-card"><div class="stat-label">Chưa kích hoạt</div><div class="stat-value">@Model.NotActivatedAccounts</div><div class="stat-note">Cần gửi hướng dẫn kích hoạt</div></div></div>
<div class="card"><form class="toolbar" method="get"><input class="form-control" style="max-width:320px" name="Search" value="@Model.Search" placeholder="Tìm mã NV, họ tên hoặc email..." /><select name="Role" style="max-width:180px"><option value="">Tất cả vai trò</option><option>Admin</option><option>HR</option><option>Manager</option><option>Employee</option></select><select name="BranchId" style="max-width:220px"><option value="">Tất cả chi nhánh</option>@foreach (var branch in Model.Branches){<option value="@branch.Id" selected="@(Model.BranchId == branch.Id)">@branch.Name</option>}</select><select name="DepartmentId" style="max-width:220px"><option value="">Tất cả phòng ban</option>@foreach (var department in Model.Departments){<option value="@department.Id" selected="@(Model.DepartmentId == department.Id)">@department.Name</option>}</select><select name="Activation" style="max-width:190px"><option value="">Tất cả trạng thái kích hoạt</option><option value="activated">Đã kích hoạt</option><option value="not-activated">Chưa kích hoạt</option></select><button class="btn btn-secondary">Lọc</button></form><div class="table-wrap" style="margin-top:18px"><table class="data-table"><thead><tr><th>Mã NV</th><th>Họ tên</th><th>Email</th><th>Thiết bị</th><th>Vai trò</th><th>Phòng ban</th><th>Chi nhánh</th><th>Kích hoạt</th><th>Tài khoản</th><th>Thao tác</th></tr></thead><tbody>@foreach(var item in Model.Employees){<tr><td><strong>@item.EmployeeCode</strong></td><td>@item.FullName</td><td>@(item.Email ?? "Chưa thêm")<br /><span class="badge @(item.IsEmailVerified ? "badge-success":"badge-warning")">@(item.IsEmailVerified ? "Email đã xác minh":"Chưa xác minh")</span></td><td>@if(string.IsNullOrWhiteSpace(item.BoundDeviceId)){<span class="badge badge-warning">Chưa liên kết</span>}else{<span class="badge badge-success">Đã liên kết</span>} </td><td><span class="badge badge-neutral">@item.Role</span></td><td>@(item.Department?.Name ?? "Chưa phân phòng ban")</td><td><strong>@(item.Branch?.Name ?? "Chưa xác định")</strong><br /><small class="muted">Mã chi nhánh: @item.BranchId</small></td><td><span class="badge @(item.IsActivated ? "badge-success":"badge-warning")">@(item.IsActivated ? "Đã kích hoạt":"Chưa kích hoạt")</span></td><td><span class="badge @(item.IsActive ? "badge-success":"badge-danger")">@(item.IsActive ? "Hoạt động":"Đã khóa")</span></td><td><div class="toolbar"><a class="btn btn-secondary" asp-page="/Admin/Employees/Edit" asp-route-id="@item.Id">Sửa</a>@if (!string.IsNullOrWhiteSpace(item.Email)){<form method="post" asp-page-handler="SendEmailOtp" asp-route-id="@item.Id"><button class="btn btn-secondary" type="submit">Gửi OTP</button></form><form method="post" asp-page-handler="RemoveEmail" asp-route-id="@item.Id" data-delete-form data-delete-message="Bạn có chắc muốn xóa email của nhân viên @item.FullName không?"><button class="btn btn-danger" type="submit">Xóa email</button></form>}@if (!string.IsNullOrWhiteSpace(item.BoundDeviceId)){<form method="post" asp-page-handler="UnbindDevice" asp-route-id="@item.Id" data-delete-form data-delete-message="Bạn có chắc muốn hủy liên kết thiết bị của nhân viên @item.FullName không?"><button class="btn btn-secondary" type="submit">Hủy liên kết</button></form>}<form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" data-delete-form data-delete-message="Bạn có chắc muốn xóa nhân viên @item.FullName không?"><button class="btn btn-danger" type="submit">Xóa</button></form><form method="post" asp-page-handler="Toggle" asp-route-id="@item.Id"><button class="btn btn-secondary">@(item.IsActive ? "Khóa":"Mở khóa")</button></form></div></td></tr>}</tbody></table></div></div>

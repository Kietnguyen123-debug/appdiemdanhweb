@page
@model AppDiemDanh.Pages.Admin.LeavesModel
@{ ViewData["Title"] = "Nghỉ phép"; }
@{ string LeaveStatus(string status) => status.ToUpperInvariant(); }
<div class="section-head"><div><p class="eyebrow">PHÚC LỢI</p><h1>Quản lý nghỉ phép</h1><p class="muted">Duyệt hoặc từ chối các đơn đang chờ xử lý.</p></div></div>
@if(Model.Message != null){<div class="alert alert-success">@Model.Message</div>}
<div class="card"><div class="table-wrap"><table class="data-table"><thead><tr><th>Nhân viên</th><th>Thời gian</th><th>Loại</th><th>Lý do</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var x in Model.Items){var status = LeaveStatus(x.Status);<tr><td><strong>@x.Employee?.EmployeeCode</strong><br />@x.Employee?.FullName</td><td>@x.StartDate.ToString("dd/MM/yyyy") — @x.EndDate.ToString("dd/MM/yyyy")</td><td>@x.LeaveType</td><td>@x.Reason</td><td><span class="badge @(status=="PENDING"?"badge-warning":status=="APPROVED"?"badge-success":"badge-danger")">@x.Status</span></td><td>@if(status=="PENDING"){<form method="post" class="toolbar"><input type="hidden" name="id" value="@x.Id" /><button class="btn btn-primary" name="approved" value="true">Duyệt</button><button class="btn btn-danger" name="approved" value="false">Từ chối</button></form>}</td></tr>}</tbody></table></div></div>
<h2 class="section-title" style="margin-top:24px">Danh sách đã duyệt</h2>
<div class="card"><div class="table-wrap"><table class="data-table"><thead><tr><th>Nhân viên</th><th>Thời gian</th><th>Loại</th><th>Lý do</th><th>Trạng thái</th></tr></thead><tbody>@if(Model.ApprovedItems.Count == 0){<tr><td colspan="5" class="muted">Chưa có đơn nghỉ nào được duyệt.</td></tr>} else { @foreach(var x in Model.ApprovedItems){<tr><td><strong>@x.Employee?.EmployeeCode</strong><br />@x.Employee?.FullName</td><td>@x.StartDate.ToString("dd/MM/yyyy") — @x.EndDate.ToString("dd/MM/yyyy")</td><td>@x.LeaveType</td><td>@x.Reason</td><td><span class="badge badge-success">Đã duyệt</span></td></tr>} }</tbody></table></div></div>

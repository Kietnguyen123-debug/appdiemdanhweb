@page
@model AppDiemDanh.Pages.Admin.ExplanationsModel
@{ ViewData["Title"] = "Giải trình chấm công"; }
@{ string ExplanationStatus(string status) => status.ToUpperInvariant(); }
<div class="section-head"><div><p class="eyebrow">KIỂM SOÁT DỮ LIỆU</p><h1>Giải trình chấm công</h1></div></div>
@if(Model.Message != null){<div class="alert alert-success">@Model.Message</div>}
<div class="card"><div class="table-wrap"><table class="data-table"><thead><tr><th>Nhân viên</th><th>Ngày thiếu</th><th>Lý do</th><th>Thời gian bổ sung</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var x in Model.Items){var status = ExplanationStatus(x.Status);<tr><td>@x.EmployeeName</td><td>@x.TargetDate.ToString("dd/MM/yyyy")</td><td>@x.ExplanationReason</td><td>IN: @(x.MissingCheckInTime?.ToString("HH:mm") ?? "—")<br />OUT: @(x.MissingCheckOutTime?.ToString("HH:mm") ?? "—")</td><td><span class="badge @(status=="PENDING"?"badge-warning":status=="APPROVED"?"badge-success":"badge-danger")">@x.Status</span></td><td>@if(status=="PENDING"){<form method="post" class="toolbar"><input type="hidden" name="id" value="@x.Id" /><button class="btn btn-primary" name="status" value="APPROVED">Duyệt</button><button class="btn btn-danger" name="status" value="REJECTED">Từ chối</button></form>}</td></tr>}</tbody></table></div></div>
<h2 class="section-title" style="margin-top:24px">Danh sách đã duyệt</h2>
<div class="card"><div class="table-wrap"><table class="data-table"><thead><tr><th>Nhân viên</th><th>Ngày thiếu</th><th>Lý do</th><th>Thời gian bổ sung</th><th>Trạng thái</th></tr></thead><tbody>@if(Model.ApprovedItems.Count == 0){<tr><td colspan="5" class="muted">Chưa có giải trình nào được duyệt.</td></tr>} else { @foreach(var x in Model.ApprovedItems){<tr><td>@x.EmployeeName</td><td>@x.TargetDate.ToString("dd/MM/yyyy")</td><td>@x.ExplanationReason</td><td>IN: @(x.MissingCheckInTime?.ToString("HH:mm") ?? "—")<br />OUT: @(x.MissingCheckOutTime?.ToString("HH:mm") ?? "—")</td><td><span class="badge badge-success">Đã duyệt</span></td></tr>} }</tbody></table></div></div>

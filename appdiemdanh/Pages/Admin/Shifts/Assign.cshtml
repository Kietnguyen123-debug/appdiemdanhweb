@page
@model AppDiemDanh.Pages.Admin.Shifts.AssignModel
@{ ViewData["Title"] = "Phân ca nhân viên"; }
<div class="section-head"><div><p class="eyebrow">LỊCH LÀM VIỆC</p><h1>Phân ca nhân viên</h1><p class="muted">Gán ca làm việc theo khoảng thời gian hiệu lực.</p></div><a class="btn btn-secondary" asp-page="/Admin/Shifts">← Về quản lý ca</a></div>
@if(Model.Message != null){<div class="alert @(Model.Success ? "alert-success":"alert-danger")">@Model.Message</div>}
<div class="card"><form method="post" class="grid grid-2"><div><label>Nhân viên</label><select class="form-control" asp-for="Input.EmployeeId" required><option value="0">-- Chọn nhân viên --</option>@foreach(var x in Model.Employees){<option value="@x.Id">@x.EmployeeCode - @x.FullName</option>}</select></div><div><label>Ca làm việc</label><select class="form-control" asp-for="Input.ShiftId" required><option value="0">-- Chọn ca --</option>@foreach(var x in Model.Shifts){<option value="@x.Id">@x.ShiftCode - @x.ShiftName</option>}</select></div><div><label>Từ ngày</label><input class="form-control" type="date" asp-for="Input.EffectiveFromDate" required /></div><div><label>Đến ngày (không bắt buộc)</label><input class="form-control" type="date" asp-for="Input.EffectiveToDate" /></div><div class="toolbar"><button class="btn btn-primary" type="submit">Phân ca</button><a class="btn btn-secondary" asp-page="/Admin/Shifts">Hủy</a></div></form></div>

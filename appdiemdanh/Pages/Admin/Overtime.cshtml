@page
@model AppDiemDanh.Pages.Admin.OvertimeModel
@{ ViewData["Title"] = "Làm thêm giờ"; }
@{ string OvertimeStatus(string status) => status.ToUpperInvariant(); }
<div class="section-head"><div><p class="eyebrow">LƯƠNG & THUẾ</p><h1>Đăng ký làm thêm giờ</h1></div></div>
@if(Model.Message != null){<div class="alert alert-success">@Model.Message</div>}
<div class="card"><div class="table-wrap"><table class="data-table"><thead><tr><th>Nhân viên</th><th>Ngày làm</th><th>Số giờ</th><th>Hệ số</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var x in Model.Items){var status = OvertimeStatus(x.Status);<tr><td>@x.Employee?.EmployeeCode - @x.Employee?.FullName</td><td>@x.WorkDate.ToString("dd/MM/yyyy")</td><td>@x.Hours</td><td>x@x.Multiplier</td><td><span class="badge @(status=="PENDING"?"badge-warning":status=="APPROVED"?"badge-success":"badge-danger")">@x.Status</span></td><td><div class="toolbar">@if(status=="PENDING"){<form method="post"><input type="hidden" name="id" value="@x.Id" /><button class="btn btn-primary" name="approved" value="true">Duyệt</button><button class="btn btn-danger" name="approved" value="false">Từ chối</button></form>}<form method="post" asp-page-handler="Delete" asp-route-id="@x.Id" data-delete-form data-delete-message="Bạn có chắc muốn xóa bản ghi OT này không?"><button class="btn btn-danger" type="submit">Xóa</button></form></div></td></tr>}</tbody></table></div></div>
<h2 class="section-title" style="margin-top:24px">Danh sách đã duyệt</h2>
<div class="card"><div class="table-wrap"><table class="data-table"><thead><tr><th>Nhân viên</th><th>Ngày làm</th><th>Số giờ</th><th>Hệ số</th><th>Trạng thái</th></tr></thead><tbody>@if(Model.ApprovedItems.Count == 0){<tr><td colspan="5" class="muted">Chưa có bản ghi OT nào được duyệt.</td></tr>} else { @foreach(var x in Model.ApprovedItems){<tr><td>@x.Employee?.EmployeeCode - @x.Employee?.FullName</td><td>@x.WorkDate.ToString("dd/MM/yyyy")</td><td>@x.Hours</td><td>x@x.Multiplier</td><td><span class="badge badge-success">Đã duyệt</span></td></tr>} }</tbody></table></div></div>

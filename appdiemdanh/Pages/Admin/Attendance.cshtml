@page
@model AppDiemDanh.Pages.Admin.AttendanceModel
@{ ViewData["Title"] = "Chấm công"; }
<div class="section-head"><div><p class="eyebrow">VẬN HÀNH</p><h1>Nhật ký chấm công</h1><p class="muted">Chọn một ngày cụ thể hoặc bỏ trống ngày để xem toàn bộ tháng.</p></div><form method="get" class="toolbar"><label><span class="form-label">Ngày cụ thể</span><input class="form-control" type="date" name="date" value="@(Model.Date?.ToString("yyyy-MM-dd"))" /></label><label><span class="form-label">Tháng</span><input class="form-control" style="width:90px" type="number" name="month" min="1" max="12" value="@Model.Month" /></label><label><span class="form-label">Năm</span><input class="form-control" style="width:110px" type="number" name="year" min="2000" max="2100" value="@Model.Year" /></label><select class="form-control" name="branchId"><option value="0">Tất cả chi nhánh</option>@foreach (var branch in Model.Branches){<option value="@branch.Id" selected="@(Model.BranchId == branch.Id ? "selected" : null)">@branch.Name</option>}</select><button class="btn btn-secondary" type="submit">Xem thống kê</button><button class="btn btn-secondary" type="button" onclick="this.form.date.value=''; this.form.submit();">Xem tháng</button><button class="btn btn-secondary" type="button" onclick="const params = new URLSearchParams(new FormData(this.form)); params.set('handler', 'ExportExcel'); window.location.assign(window.location.pathname + '?' + params.toString());">Xuất Excel</button></form></div>
<div class="grid grid-4"><div class="card stat-card"><div class="stat-label">Tổng bản ghi</div><div class="stat-value">@Model.Records.Count</div></div><div class="card stat-card"><div class="stat-label">Đã check-in</div><div class="stat-value">@Model.Records.Count(x => x.CheckInTime != default)</div></div><div class="card stat-card"><div class="stat-label">Đã check-out</div><div class="stat-value">@Model.Records.Count(x => x.CheckOutTime.HasValue)</div></div><div class="card stat-card"><div class="stat-label">Đi trễ</div><div class="stat-value">@Model.Records.Count(x => x.LateMinutes > 0)</div></div></div>
<div class="card" style="margin-top:20px"><div class="table-wrap"><table class="data-table"><thead><tr><th>Nhân viên</th><th>Ngày</th><th>Check-in</th><th>Check-out</th><th>Đi trễ</th><th>Về sớm</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var x in Model.Records){<tr><td><strong>@x.Employee?.EmployeeCode</strong><br /><span class="muted">@x.Employee?.FullName</span></td><td>@x.WorkDate.ToString("dd/MM/yyyy")</td><td>@(x.CheckInTime == default ? "—" : x.CheckInTime.ToString("HH:mm"))</td><td>@(x.CheckOutTime?.ToString("HH:mm") ?? "—")</td><td>@x.LateMinutes phút</td><td>@x.EarlyLeaveMinutes phút</td><td><span class="badge badge-success">@x.Status</span></td></tr>}</tbody></table></div></div>
